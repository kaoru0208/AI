from pathlib import Path
from time import sleep
import yaml

yml = Path(__file__).with_name("best_params.yaml")
if not yml.exists():
    for _ in range(12):  # 5 秒 × 12 回
        sleep(5)
        if yml.exists():
            break
    else:
        raise FileNotFoundError("best_params.yaml が見つかりません")

params      = yaml.safe_load(yml.read_text())
EMA_FAST    = params["ema_fast"]
EMA_SLOW    = params["ema_slow"]
RSI_LEN     = params["rsi_len"]
RISK_PCT    = params.get("risk_pct", 0.01)
