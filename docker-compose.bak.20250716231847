version: "3.9"
services:
  mlflow:
    image: ghcr.io/mlflow/mlflow:v2.12.1
    ports: ["5500:5500"]
      mlflow server
      --backend-store-uri sqlite:///mlflow.db
      --default-artifact-root ./mlruns
      --host 0.0.0.0
      --port 5500
      - "5500:5000"
    volumes:
      - ./mlruns:/app/mlruns
  timescaledb:
    image: timescale/timescaledb:latest-pg15
